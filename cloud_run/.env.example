# .env 템플릿 — 실제 값은 .env 파일(같은 폴더, git에 올라가지 않음)에 넣으세요.

# 파싱에 쓸 AI 선택: claude 또는 gemini (기본값 claude)
PARSER_ENGINE=claude

# PARSER_ENGINE=claude일 때 사용. 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# PARSER_ENGINE=gemini일 때 사용. 발급: https://aistudio.google.com/apikey
# (주의: Claude 세션 안에서는 네트워크 제약으로 이 엔진 테스트가 막혀 있을 수 있음 —
#  사용자 자신의 PC에서 실행하면 정상 동작함)
GEMINI_API_KEY=

BC_CARD_PASSWORD=
HYUNDAI_CARD_PASSWORD=
SAMSUNG_CARD_PASSWORD=
SHINHAN_CARD_PASSWORD=

# Google Sheets 쓰기용 서비스 계정 키(JSON 전체를 한 줄로) + 대상 시트 ID.
# GCP 콘솔에서 서비스 계정 키(JSON) 발급 후, 해당 서비스 계정 이메일을 대상
# 스프레드시트에 편집자로 공유해야 함.
SHEETS_SERVICE_ACCOUNT_JSON=
SHEET_ID=

# 로컬에서 test_gmail_fetch.py로 "실제 메일함에서 검색해서 읽기"를 테스트할 때만 사용.
# (운영 시 Apps Script는 GmailApp의 자체 OAuth로 동작하므로 이 값이 필요 없음.)
# GMAIL_ADDRESS: 명세서를 수신하는 실제 Gmail 주소.
# GMAIL_APP_PASSWORD: 일반 로그인 비밀번호 아님 — Google 계정에 2단계 인증을 켠 뒤
#   https://myaccount.google.com/apppasswords 에서 발급하는 16자리 앱 비밀번호.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
